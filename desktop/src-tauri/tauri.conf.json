{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Envoxers Desktop",
  "version": "0.2.2",
  "identifier": "br.com.envox.envoxers.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Envoxers",
        "url": "https://envoxers.envox.com.br/?envoxers_desktop=1",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#FAFAF7"
      }
    ],
    "security": {
      "capabilities": [
        "envoxers-remote"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
