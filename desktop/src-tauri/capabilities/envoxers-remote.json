{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "envoxers-remote",
  "description": "Permite somente os quatro comandos nativos do Envoxers para o domínio oficial",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://envoxers.envox.com.br/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-native-alert",
    "allow-native-badge",
    "allow-native-status",
    "allow-native-set-autostart",
    "allow-native-download",
    "allow-native-save-file",
    "allow-native-check-update",
    "allow-native-install-update"
  ]
}
